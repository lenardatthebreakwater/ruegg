# Copy this file to .env.local and fill in the values.
# Ask a teammate for the correct values.

# Optional — Chatway live chat (omit NEXT_PUBLIC_CHATWAY_ID to disable).
# Widget id from the Chatway install snippet (?id=…).
# NEXT_PUBLIC_CHATWAY_ID=30wEtqS9wEEX
# Ms after window load before injecting the widget (default 5000). Helps PageSpeed/GTmetrix.
# NEXT_PUBLIC_CHATWAY_DELAY_MS=5000

# Cloudflare Turnstile (contact + login).
# Local: Cloudflare dummy always-pass keys (below) are fine for `next dev`.
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Production: NEXT_PUBLIC_* is inlined at **build** time — Worker Variables alone are
# NOT enough for the client widget. Linux deploy sets the real peisbutikken.no sitekey
# in scripts/deploy-linux-wsl.sh; TURNSTILE_SECRET_KEY stays a Worker Secret (keep_vars).
# Real sitekey (public): 0x4AAAAAAAPSjVBsSPee1nan
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional — Google Tag Manager (omit NEXT_PUBLIC_GTM_ID to disable GTM).
# IMPORTANT: NEXT_PUBLIC_GTM_ID is the WEB container ID only (browser snippet).
# Do NOT put the SERVER / sGTM container ID here — that stays in GTM Admin
# (server container URL / transport URL). They look alike (both GTM-…) but differ.
# Production web container (new Next storefront; not the old WordPress containers):
# NEXT_PUBLIC_GTM_ID=GTM-M6BX6KG2
# First-party loader via Hetzner sGTM proxy (/cartdata) — see
# docs/seo/sgtm-hetzner-cartdata-setup.md. SCRIPT_QUERY must be `id=GTM-…`
# for stock gtm.js; only Stape-style custom loaders use a token query instead.
# NEXT_PUBLIC_GTM_SCRIPT_URL=https://peisbutikken.no/cartdata/gtm.js
# NEXT_PUBLIC_GTM_SCRIPT_QUERY=id=GTM-M6BX6KG2
# NEXT_PUBLIC_GTM_NOSCRIPT_URL=https://peisbutikken.no/cartdata/ns.html
# Optional — append to GA4 ecommerce `event` for a second `dataLayer` push (Stape GTM
# Custom Event triggers, e.g. add_to_cart_stape). Unset = default _stape; empty = off.

# Required — WordPress headless WooCommerce GraphQL endpoint
# Example (production): https://peisbutikken.no/graphql
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=

# Required — shadcn/studio premium registries (for adding premium components)
EMAIL=
LICENSE_KEY=

# Optional — explicit site URL (defaults to derived from GraphQL URL)
# NEXT_PUBLIC_WORDPRESS_SITE_URL=https://your-wordpress-site.com
# Optional — canonical storefront URL for SEO metadata and schema
# NEXT_PUBLIC_SITE_URL=https://www.peisbutikken.no

# Optional — override paths if your WordPress uses different endpoints
# NEXT_PUBLIC_WORDPRESS_CHECKOUT_PATH=/checkout/
# NEXT_PUBLIC_WORDPRESS_CART_SYNC_PATH=/wp-json/pb/v1/cart-sync
# WordPress (wp-config.php): optional PB_CART_SYNC_SECRET — if set, append &secret=... to cart-sync URL (not sent by Next by default; add only if you harden the endpoint).
# WORDPRESS_SHIPPING_QUOTE_PATH=/wp-json/pb/v1/shipping-quote
# WORDPRESS_SIDE_CART_UPSELLS_PATH=/wp-json/pb/v1/side-cart-order-bumps

# Optional — accessories category slug (default: peistilbehor)
# NEXT_PUBLIC_ACCESSORIES_CATEGORY_SLUG=peistilbehor

# Optional — enable debug logging for accessories in production
# NEXT_PUBLIC_DEBUG_ACCESSORIES=true

# Optional — secret for shipping quote API (server-side only)
# WORDPRESS_SHIPPING_QUOTE_SECRET=your-secret
# Optional — secret for side cart recommendations API (server-side only; matches PB_SIDE_CART_ORDER_BUMPS_SECRET or PB_SIDE_CART_UPSELLS_SECRET in wp-config.php — see wordpress-pb-side-cart-order-bumps.php)
# WORDPRESS_SIDE_CART_UPSELLS_SECRET=your-secret
# Optional — auth endpoint paths and secrets (server-side only)
# WORDPRESS_AUTH_LOGIN_PATH=/wp-json/pb/v1/auth/login
# WORDPRESS_AUTH_SIGNUP_PATH=/wp-json/pb/v1/auth/signup
# WORDPRESS_AUTH_ME_PATH=/wp-json/pb/v1/auth/me
# WORDPRESS_AUTH_LOGOUT_PATH=/wp-json/pb/v1/auth/logout
# WORDPRESS_AUTH_PASSWORD_REQUEST_PATH=/wp-json/pb/v1/auth/password/request-reset
# WORDPRESS_AUTH_PASSWORD_RESET_PATH=/wp-json/pb/v1/auth/password/reset
# WORDPRESS_AUTH_PASSWORD_CHANGE_PATH=/wp-json/pb/v1/auth/password/change
# WORDPRESS_AUTH_ORDERS_PATH=/wp-json/pb/v1/auth/orders
# WORDPRESS_AUTH_ADDRESSES_PATH=/wp-json/pb/v1/auth/addresses
# WORDPRESS_AUTH_PAYMENT_METHODS_PATH=/wp-json/pb/v1/auth/payment-methods
# WORDPRESS_AUTH_SSO_CODE_PATH=/wp-json/pb/v1/auth/sso-code
# WORDPRESS_AUTH_SHARED_SECRET=your-secret
# AUTH_SESSION_SECRET=replace-with-strong-secret

# Code Snippets REST API (agent deploy of docs/wordpress/snippets/*).
# Application Password from WP Admin → Users → Profile (not the normal login password).
# See docs/wordpress/SNIPPETS.md. Never commit real values.
# WP_USER=your-wp-admin-username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional — Cloudflare R2 config for contact attachments (server-side only)
# CONTACT_R2_ACCOUNT_ID=your-cloudflare-account-id
# CONTACT_R2_BUCKET_NAME=peisbutikken-contact-attachments
# CONTACT_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CONTACT_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CONTACT_R2_PUBLIC_BASE_URL=https://contact-files.peisbutikken.no

# Optional — OpenNext deploy --rclone (skips unchanged incremental-cache objects).
# Create via R2 Overview → Account details → Manage API Tokens (NOT Account API tokens).
# Scope Object Read & Write to bucket peisbutikken-next-inc-cache-weur.
# Put these in Windows .dev.vars (deploy script reads them; never commit).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CF_ACCOUNT_ID=790d23c5ece51fcc302ebf9d4471411a

# Optional — contact upload constraints (server-side only)
# CONTACT_UPLOAD_MAX_FILES=5
# CONTACT_UPLOAD_MAX_FILE_BYTES=10485760
# CONTACT_UPLOAD_ALLOWED_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/bmp,image/webp,image/avif,image/heic,image/heif,image/tiff,image/tif,application/pdf,application/x-pdf
# CONTACT_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.bmp,.webp,.avif,.heic,.heif,.tif,.tiff,.pdf

# Optional — contact email sending via Cloudflare Email Service REST API (server-side only)
# See CLOUDFLARE.md — domain must be onboarded for Email Sending in Cloudflare.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# (If unset, CONTACT_R2_ACCOUNT_ID is used — same account in typical setups.)
# Contact mail only (do not reuse CLOUDFLARE_API_TOKEN for email if wrangler also needs
# a deploy token for Workers/R2; see CLOUDFLARE.md)
# CONTACT_EMAIL_API_TOKEN=token-with-Account-Email-Sending-Send
# CONTACT_EMAIL_FROM=no-reply@your-domain.no
# CONTACT_EMAIL_FROM_NAME=Peisbutikken
# Required in production: staff inbox for contact form (client recipient is ignored).
# CONTACT_RECIPIENT_OVERRIDE=post@peisbutikken.no
# CONTACT_EMAIL_ATTACHMENTS_MODE=url

# Optional — product cache tuning (server-side only)
# Route ISR for shop/PDP/archives is 7 days in code; webhook is the primary purge.
# These control GraphQL fetch/`unstable_cache` freshness during regeneration.
# PRODUCTS_ARCHIVE_REVALIDATE_SECONDS=300
# PRODUCT_DETAIL_REVALIDATE_SECONDS=900
# PRODUCTS_EDGE_MAX_AGE_SECONDS=300
# PRODUCTS_EDGE_STALE_WHILE_REVALIDATE_SECONDS=3600
# PRODUCT_DETAIL_EDGE_MAX_AGE_SECONDS=900
# PRODUCT_DETAIL_EDGE_STALE_WHILE_REVALIDATE_SECONDS=3600
# Optional override for Product offer priceValidUntil (default: today UTC + 1 year)
# NEXT_PUBLIC_SCHEMA_PRICE_VALID_UNTIL=2027-12-31

# Optional — signed WordPress webhook secret for product revalidation
# Sent in header: X-Revalidate-Secret
# PRODUCT_REVALIDATE_SECRET=your-strong-shared-secret
# On product save, WordPress should POST slug(s) here so the correct PDP +
# archives/search/sitemap tags are purged (do not rely on the 7-day ISR alone).
# Optional — search index cache + rebuild controls (server-side only)
# Daily rebuild target (default: 86400)
# SEARCH_INDEX_REVALIDATE_SECONDS=86400
# Shared secret for POST /api/search-index/rebuild
# SEARCH_INDEX_REBUILD_SECRET=your-strong-shared-secret

# Google Business Profile — live reviews on homepage (server-side only)
# Without these, the storefront shows static fallback quotes from `lib/data/homepage.ts`.
# GMB_CLIENT_ID=
# GMB_CLIENT_SECRET=
# GMB_REFRESH_TOKEN=
# GMB_ACCOUNT_ID=accounts/123456789012345678901
# GMB_LOCATION_ID=locations/1234567890123456789
# Optional cap for paginated fetches (default: 20 pages * 50 reviews)
# GMB_MAX_PAGES=20

