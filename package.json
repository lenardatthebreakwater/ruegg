{
  "name": "ruegg-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "build:next": "next build",
    "measure:shop-cache": "npx tsx --require ./scripts/stub-server-only.cjs scripts/measure-shop-archive-cache.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "url:fetch-live-sitemap": "node --experimental-strip-types scripts/url-mirror/fetch-live-sitemap.ts",
    "url:check-parity": "node --experimental-strip-types scripts/url-mirror/check-url-parity.ts",
    "build:cloudflare": "node scripts/run-opennext-loud.mjs build",
    "preview": "node scripts/run-opennext-loud.mjs build && node scripts/run-opennext-loud.mjs preview",
    "release:check": "node scripts/release-check.mjs",
    "release:build:verify": "node scripts/release-build-verify.mjs",
    "deploy": "node scripts/deploy-opennext.mjs",
    "deploy:opennext": "node scripts/deploy-opennext.mjs",
    "smoke:pdps": "node scripts/verify-pdp-smoke.mjs",
    "warm": "node scripts/warm-cache.mjs",
    "cache:prune-r2": "node scripts/cleanup-r2-inc-cache.mjs",
    "cache:prune-r2:execute": "node scripts/cleanup-r2-inc-cache.mjs --execute",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@animateicons/react": "^0.3.4",
    "@aws-sdk/client-s3": "^3.1024.0",
    "@next/third-parties": "^16.1.6",
    "@opennextjs/cloudflare": "1.20.1",
    "@smithy/fetch-http-handler": "^5.3.15",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "patch-package": "^8.0.1",
    "rclone.js": "^0.6.6",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260710.1": true,
    "rclone.js@0.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
